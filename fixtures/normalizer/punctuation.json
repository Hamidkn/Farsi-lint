{
  "rule": "punctuation",
  "description_en": "Use Persian comma/semicolon/question mark in Persian prose, with context-aware spacing.",
  "cases": [
    {
      "input": "سلام, دوست من.",
      "expected": "سلام، دوست من.",
      "options": {},
      "kind": "positive",
      "note": "Persian-context comma",
      "reviewed": false,
      "id": "punctuation-001"
    },
    {
      "input": "آمدم; کسی نبود.",
