{
  "rule": "quotes",
  "description_en": "Convert paired straight/curly quotes around Persian prose, preserving English and structured data.",
  "cases": [
    {
      "input": "او گفت: \"سلام\".",
      "expected": "او گفت: «سلام».",
      "options": {},
      "kind": "positive",
      "note": "Straight quotation marks",
      "reviewed": false,
      "id": "quotes-001"
    },
    {
      "input": "او گفت: “سلام”.",
      "expected": "او گفت: «سلام».",
      "options": {},
      "kind": "positive",
      "note": "Curly quotation marks",
      "reviewed": false,
      "id": "quotes-002"
    },
    {
      "input": "\"کتاب\" را بخوان.",
      "expected": "«کتاب» را بخوان.",
      "options": {},
      "kind": "positive",
      "note": "Quoted object at sentence start",
      "reviewed": false,
      "id": "quotes-003"
    },
    {
      "input": "“پایان”",
      "expected": "«پایان»",
      "options": {},
      "kind": "positive",
      "note": "Standalone curly quotation",
      "reviewed": false,
      "id": "quotes-004"
    },
    {
      "input": "عنوان: \"راهنمای سفر\"",
