{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Persian normalizer fixture file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule",
    "description_en",
    "cases"
  ],
  "properties": {
    "rule": {
      "enum": [
        "arabic-letters",
        "digits",
        "zwnj",
        "zwnj-cleanup",
        "spaces",
        "punctuation",
        "quotes",
        "brackets-spacing",
        "ellipsis",
        "kashida",
        "heh-ye",
        "protected-spans",
        "combined"
      ]
    },
    "description_en": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "expected",
        "options",
        "kind",
        "note",
        "reviewed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z-]+-\\d{3}$"
        },
        "input": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "digits": {
              "enum": [
                "persian",
                "keep"
              ]
            },
            "hehYeStyle": {
              "enum": [
                "hamza",
                "zwnj"
              ]
            }
          }
        },
        "kind": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "reviewed": {
          "type": "boolean"
        }
      }
    }
  },
